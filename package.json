{
	"name": "kestrel",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"check": "biome check . && tsc -b && vitest run",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"hono": "^4.12.32",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-globe.gl": "^2.38.0",
		"react-router": "^8.3.0",
		"recharts": "^3.10.1",
		"three": "^0.185.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/vite-plugin": "^1.47.0",
		"@cloudflare/vitest-pool-workers": "^0.18.8",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.185.1",
		"@vitejs/plugin-react": "^6.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	},
	"packageManager": "pnpm@11.0.6"
}
